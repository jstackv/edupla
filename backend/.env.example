# ── Required ──────────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=edupla
JWT_SECRET=change_me_to_a_long_random_string

# ── Optional ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# Cloudinary (file uploads for Notes & Documents / assignments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (welcome, account activate/deactivate, password reset, assignment /
# document / announcement / assessment notifications).
# EMAIL_HOST, EMAIL_USER and EMAIL_PASS are ALL required — if any is missing,
# every email is silently skipped (only a console warning is logged).
# On Vercel set these in Project → Settings → Environment Variables, then redeploy.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false          # true only for port 465
EMAIL_USER=
EMAIL_PASS=                 # Gmail: use a 16-char App Password, not your login password
EMAIL_FROM="EDUPLA <you@example.com>"

# AI question generation (assessmentController quiz auto-generation)
GEMINI_API_KEY=

# MoMo payments (billing)
MOMO_API_KEY=
MOMO_API_USER=
MOMO_BASE_URL=
MOMO_CALLBACK_HOST=
MOMO_CURRENCY=
MOMO_DEBUG=
MOMO_SUBSCRIPTION_KEY=
MOMO_TARGET_ENVIRONMENT=

# Default seeded credentials
STUDENT_DEFAULT_PASSWORD=
TEACHER_DEFAULT_PASSWORD=
EDUPLA_OWNER_EMAIL=
EDUPLA_OWNER_NAME=
EDUPLA_OWNER_PHONE=
SUBSCRIPTION_AMOUNT=
SUBSCRIPTION_PLAN_DAYS=
TRIAL_DAYS=
